PROJECT_NAME=Nestro
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=False
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nestro
# Supabase project URL (no trailing slash); enables JWKS-based JWT verification.
# e.g. https://YOUR-PROJECT-REF.supabase.co
SUPABASE_URL=
JWT_SECRET=change-me
JWT_VERIFICATION_KEY=
# Supabase access-token issuer. Defaults to <SUPABASE_URL>/auth/v1 when
# SUPABASE_URL is set; uncomment to override explicitly.
# JWT_ISSUER=https://YOUR-PROJECT-REF.supabase.co/auth/v1
JWT_AUDIENCE=authenticated